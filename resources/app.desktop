[Desktop Entry]
Name=Cosmic Applet Quick Settings
Comment=A cosmic quick settings applet
Type=Application
Icon=com.github.chrispouliot.cosmic-applet-quick-settings
Exec=cosmic-applet-quick-settings %F
Terminal=false
StartupNotify=true
Categories=COSMIC
Keywords=COSMIC
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
MimeType=
